Options -MultiViews
DirectoryIndex index.html

RewriteEngine On
RewriteBase /girosto/

RewriteRule ^categories/girosto-special/ready-halim-mix(?:\.html)?$ catagories/girosto-special/ready-halim-mix [R=301,L,NE,NC]
RewriteRule ^shop/product/ready-halim-mix(?:\.html)?$ catagories/girosto-special/ready-halim-mix [R=301,L,NE,NC]

# Permanently migrate selected product URLs directly to their final category paths.
RewriteRule ^shop/product/virgin-cold-pressed-mustard-oil(?:\.html)?$ catagories/girosto-special/virgin-cold-pressed-mustard-oil [R=301,L,NE,NC]
RewriteRule ^shop/product/premium-clone-tea(?:\.html)?$ catagories/girosto-special/clone-tea [R=301,L,NE,NC]
RewriteRule ^shop/product/rakhi-mustard-oil(?:\.html)?$ catagories/girosto-special/fermented-mustered-oil [R=301,L,NE,NC]
RewriteRule ^shop/product/rolled-oats(?:\.html)?$ catagories/girosto-special/homemade-rolled-oats [R=301,L,NE,NC]
RewriteRule ^shop/product/meat-masala(?:\.html)?$ catagories/girosto-special/ready-mix-beef-masala [R=301,L,NE,NC]
RewriteRule ^shop/product/biryani-masala(?:\.html)?$ catagories/girosto-special/ready-mix-biryani-masala [R=301,L,NE,NC]
RewriteRule ^shop/product/hand-roasted-red-puffed-rice(?:\.html)?$ catagories/girosto-special/handmade-puffed-rice [R=301,L,NE,NC]
RewriteRule ^shop/product/mushroom-masala(?:\.html)?$ catagories/girosto-special/mashroom-spice [R=301,L,NE,NC]
RewriteRule ^shop/product/thai-mushroom-soup(?:\.html)?$ catagories/girosto-special/thai-mushroom-soup [R=301,L,NE,NC]
RewriteRule ^shop/product/mushroom-corn-soup(?:\.html)?$ catagories/girosto-special/mushroom-corn-soup [R=301,L,NE,NC]
RewriteRule ^shop/product/aman-red-flattened-rice(?:\.html)?$ catagories/girosto-special/lal-chira [R=301,L,NE,NC]
RewriteRule ^shop/product/traditional-milk-cream-ghee(?:\.html)?$ catagories/dairy-poultry/pure-ghee [R=301,L,NE,NC]
RewriteRule ^shop/product/turmeric-powder(?:\.html)?$ catagories/ground-spices/turmeric-powder [R=301,L,NE,NC]
RewriteRule ^shop/product/chilli-powder(?:\.html)?$ catagories/ground-spices/pure-chilli-powder [R=301,L,NE,NC]
RewriteRule ^shop/product/roasted-cumin-powder(?:\.html)?$ catagories/ground-spices/pure-cumin-powder [R=301,L,NE,NC]
RewriteRule ^shop/product/coriander-powder(?:\.html)?$ catagories/ground-spices/pure-coriander-powder [R=301,L,NE,NC]
RewriteRule ^shop/product/hand-roasted-vermicelli(?:\.html)?$ catagories/girosto-special/handmade-bogura-semai [R=301,L,NE,NC]
RewriteRule ^shop/product/handmade-cane-sugar(?:\.html)?$ catagories/girosto-special/homemade-cane-sugar [R=301,L,NE,NC]
RewriteRule ^shop/product/green-tea(?:\.html)?$ catagories/girosto-special/green-tea [R=301,L,NE,NC]
RewriteRule ^shop/product/shrimp-balachao(?:\.html)?$ catagories/girosto-special/homemade-chingri-balachao [R=301,L,NE,NC]
RewriteRule ^shop/product/coconut-oil-hair-care(?:\.html)?$ catagories/girosto-special/hair-care-coconut-oil [R=301,L,NE,NC]
RewriteRule ^shop/product/garlic-pickle(?:\.html)?$ catagories/girosto-special/special-garlic-pickle [R=301,L,NE,NC]

# Permanently migrate legacy product-code URLs to English product slugs.
RewriteRule ^shop/product/(g-[0-9]+(?:-[0-9]+)?)(?:\.html)?$ product-redirect.php?id=$1 [L,QSA,NC]

# Preserve SEO value after renaming the Thai mushroom soup product URL.
RewriteRule ^shop/product/thai-corn-mushroom-soup(?:\.html)?$ catagories/girosto-special/thai-mushroom-soup [R=301,L,NE,NC]

# Legacy category URLs: permanently redirect to concise SEO slugs.
RewriteRule ^shop/category/BuyOrganicRiceOnlineinBangladeshGirosto(?:\.html)?$ shop/category/rice [R=301,L,NE,NC]
RewriteRule ^shop/category/BuyPureMustardOilOnlineinBangladeshGirosto(?:\.html)?$ shop/category/mustard-oil [R=301,L,NE,NC]
RewriteRule ^shop/category/BuyPremiumHealthyOilOnlineinBangladeshGirosto(?:\.html)?$ shop/category/healthy-oils [R=301,L,NE,NC]
RewriteRule ^shop/category/BuyPremiumLentilsPulsesinBangladeshGirosto(?:\.html)?$ shop/category/lentils-pulses [R=301,L,NE,NC]
RewriteRule ^shop/category/BuyPremiumGroundSpicesinBangladeshGirosto(?:\.html)?$ shop/category/ground-spices [R=301,L,NE,NC]
RewriteRule ^shop/category/BuyPremiumWholeSpicesinBangladeshGirosto(?:\.html)?$ shop/category/whole-spices [R=301,L,NE,NC]
RewriteRule ^shop/category/BuyPremiumSugarOnlineinBangladeshGirosto(?:\.html)?$ shop/category/sugar [R=301,L,NE,NC]
RewriteRule ^shop/category/BuyPremiumJaggeryinBangladeshGirosto(?:\.html)?$ shop/category/jaggery [R=301,L,NE,NC]
RewriteRule ^shop/category/HomemadePicklesinBangladeshGirosto(?:\.html)?$ shop/category/homemade-pickles [R=301,L,NE,NC]
RewriteRule ^shop/category/BuyPremiumHealthySeedsinBangladeshGirosto(?:\.html)?$ shop/category/healthy-seeds [R=301,L,NE,NC]
RewriteRule ^shop/category/HairskincareoilsinBangladeshGirosto(?:\.html)?$ shop/category/hair-skin-care [R=301,L,NE,NC]
RewriteRule ^shop/category/BuyPremiumDairyPoultryinBangladeshGirosto(?:\.html)?$ shop/category/dairy-poultry [R=301,L,NE,NC]
RewriteRule ^shop/category/BuyDailyHealthyFoodinBangladesh(?:\.html)?$ shop/category/daily-needs [R=301,L,NE,NC]
RewriteRule ^shop/category/GirostoSpecialItemsinBangladesh(?:\.html)?$ shop/category/girosto-special [R=301,L,NE,NC]
RewriteRule ^shop/category/OriginalHoneyinBangladesh(?:\.html)?$ shop/category/honey [R=301,L,NE,NC]
RewriteRule ^shop/category/PremiumDatesDryFruitsinBangladesh(?:\.html)?$ shop/category/dates-dry-fruits [R=301,L,NE,NC]
RewriteRule ^shop/category/PremiumNutsinBangladesh(?:\.html)?$ shop/category/nuts [R=301,L,NE,NC]
RewriteRule ^shop/category/OrganicHerbPowderinBangladesh(?:\.html)?$ shop/category/herb-powders [R=301,L,NE,NC]
RewriteRule ^shop/category/GenuineHealthItemsinBangladesh(?:\.html)?$ shop/category/health-items [R=301,L,NE,NC]
RewriteRule ^shop/category/OrganicFreshFruitsinBangladesh(?:\.html)?$ shop/category/fresh-fruits [R=301,L,NE,NC]

# Redirect direct .html requests to their public extensionless URL.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
RewriteRule ^(.*/)?index\.html$ $1 [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[?\s]) [NC]
RewriteRule ^(.+)\.html$ $1 [R=301,L,NE]

# Internally serve an existing .html file for an extensionless request.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
